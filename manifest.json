{
  "manifest_version": 3,
  "name": "Right Tabs Local",
  "short_name": "Right Tabs",
  "description": "右側のサイドパネルでタブを管理する、外部送信なしのローカル専用拡張機能。",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "tabs",
    "tabGroups",
    "favicon"
  ],
  "action": {
    "default_title": "右側の垂直タブを開く",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'; img-src 'self' data:; style-src 'self';"
  }
}
